# Copy to .env for local runs, or set these in your host's dashboard.
NODE_ENV=production
PORT=8080

# A long random string. Signs Doingz's own player tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Where the SQLite database lives. Must be a persistent disk or volume in production.
DATA_DIR=/data

# From lagoslife.app/developers/keys (shown once). Keep the test pair after approval so the sandbox still works.
VATAR_SECRET_TEST=vtr_test_...
VATAR_WEBHOOK_SECRET_TEST=vtr_whsec_test_...
# Signs each finished friend game's winner. Friend games still play without it, but Lagos Life won't settle them.
VATAR_RESULTS_SECRET_TEST=

# Added after Vatar approves Doingz.
VATAR_SECRET_LIVE=
VATAR_WEBHOOK_SECRET_LIVE=
VATAR_RESULTS_SECRET_LIVE=

# Proxies in front of the server (1 on Render, Railway or Fly). Used for per-IP sign-in limits.
TRUST_PROXY_HOPS=1

# Local testing only: a pretend player when the game isn't inside Lagos Life. Ignored when NODE_ENV=production.
# DEV_AUTH=1
